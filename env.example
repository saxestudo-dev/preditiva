NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://preditiva:preditiva_dev_password@db:5432/preditiva
SESSION_SECRET=CHANGE-ME-TO-A-LONG-RANDOM-SECRET
COOKIE_SECURE=false

# SMTP institucional (não usar e-mail pessoal sem autorização da TI)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Preditiva & Alertas Antecipados <nao-responder@instituicao.gov.br>

# Gere com: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:ti@instituicao.gov.br
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Caminho de armazenamento privado dos comprovantes
UPLOAD_DIR=./private_uploads
MAX_UPLOAD_MB=10
